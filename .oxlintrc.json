{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "off"
  },
  "rules": {},
  "ignorePatterns": [
    "web/vendor/",
    "web/src/vendor/"
  ],
  "overrides": [
    {
      "files": ["web/src/**/*.jsx", "web/src/**/*.js", "web/src/**/*.tsx", "web/src/**/*.ts"],
      "env": { "browser": true, "es2022": true },
      "rules": { "no-undef": "error" }
    }
  ]
}
