# CardLink Harness 本地配置模板。复制为 .env 并填入真实值；.env 不入库。
# 模型服务（OpenAI 兼容）；密钥只保存在服务端环境变量/.env，绝不写入仓库与日志。
H1_MODEL_BASE_URL=http://127.0.0.1:3065/v1
H1_MODEL_API_KEY=sk-your-key
H1_MODEL_NAME=glm-5.3-flash
H1_REVIEWER_MODEL_NAME=glm-5.3-flash
# HTTP 服务
H1_BIND=127.0.0.1
H1_PORT=7310
H1_HTTP_TOKEN=generate-a-long-random-token
# 存储
H1_DB_PATH=./data/agent_h1.sqlite
# 活体模型冒烟测试开关（仅本地测试用）
H1_LIVE_MODEL=0
